{
  "name": "vfs-docs-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": [
      "./src/lib/*",
      "./src/lib/*.ts",
      "./src/lib/*/index.ts"
    ]
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
    "test": "bun test ./tests/build.test.ts && bun --bun playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/saira-stencil": "5.3.0",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.0",
    "marked": "18.2.0",
    "phosphor-svelte": "^3.1.1",
    "shadcn-svelte": "^1.7.1",
    "shiki": "^4.5.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
