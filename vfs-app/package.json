{
  "name": "vfs-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && NODE_OPTIONS='--import ./ssg/register.mjs' vite-react-ssg build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
