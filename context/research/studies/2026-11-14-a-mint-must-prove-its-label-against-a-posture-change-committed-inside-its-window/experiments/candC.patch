+EPOCH_KEY: Final = "vfs_label_epoch"
+POSTURE_MOVED: Final = "a posture changed while it ran"
+
+
+async def watch_postures(session: AsyncSession, tables: VFSTables) -> None:
+    """Record the everyone stamp the attempt's labels are read under, before its first label read."""
+    if EPOCH_KEY not in session.info:
+        session.info[EPOCH_KEY] = await everyone_stamp(session, tables, None)
+
+
+async def hold_postures(session: AsyncSession, tables: VFSTables, profile: DialectProfile) -> None:
+    """Prove no posture write committed since the attempt's label read, and hold every later one out to the commit."""
+    epoch = session.info.get(EPOCH_KEY)
+    if epoch is None:
+        return
+    # A store at this format always holds the row; a hold that finds none locked nothing and must not commit.
+    if await everyone_stamp(session, tables, profile) != epoch:
+        raise StaleSnapshot(POSTURE_MOVED)
+
+
+async def everyone_stamp(session: AsyncSession, tables: VFSTables, share: DialectProfile | None) -> int:
+    """The everyone principal's stamp; with *share*, read under a lock a posture write waits behind and mints share."""
+    revisions = tables.principal_revisions
+    stmt = select(revisions.c.revision).where(revisions.c.principal_id == EVERYONE_NAME)
+    if share is not None:
+        if share.name == "oracle":
+            name = session.get_bind().dialect.identifier_preparer.format_table(revisions)
+            await session.execute(text(f"LOCK TABLE {name} IN SHARE MODE"))
+        elif share.name == "mssql":
+            stmt = stmt.with_hint(revisions, "WITH (REPEATABLEREAD, FORCESEEK)", dialect_name="mssql")
+        else:
+            stmt = stmt.with_for_update(read=True)
+    found = (await session.execute(stmt)).scalar_one_or_none()
+    return -1 if found is None and share is not None else int(found or 0)
+
+
+async def open_relabel(session: AsyncSession, tables: VFSTables, profile: DialectProfile, path: str, revision: int) -> None:
+    """A posture write's first acts: queue later mints behind it where row sharers do not queue, stamp, mark."""
+    if profile.name == "postgresql":
+        name = session.get_bind().dialect.identifier_preparer.format_table(tables.principal_revisions)
+        await session.execute(text(f"LOCK TABLE {name} IN EXCLUSIVE MODE"))
+    await stamp_principals(session, tables, [EVERYONE_NAME], revision)
+    await mark_relabel(session, tables, path, revision)
+
