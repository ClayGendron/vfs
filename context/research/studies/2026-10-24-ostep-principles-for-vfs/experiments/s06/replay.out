== 1. write replay: identical body re-sent
write /a.md 'one'                            ok=True  errs=[] rows=[('/a.md', 'created', 1)]
write /a.md 'one' (replay)                   ok=True  errs=[] rows=[('/a.md', 'updated', 2)]
   stat /a.md (version, hash): [(2, '7692c3ad')]  version rows: 0
write /a.md 'two'                            ok=True  errs=[] rows=[('/a.md', 'updated', 3)]
   stat: [(3, '3fc4ccfe')]  version rows: 1
write /a.md 'two' (replay)                   ok=True  errs=[] rows=[('/a.md', 'updated', 4)]
   stat: [(4, '3fc4ccfe')]  version rows: 1

== 2. delayed replay after a rival writer (NFS Case 3 + a second client)
agent A writes 'A'                           ok=True  errs=[] rows=[('/b.md', 'updated', 2)]
agent B writes 'B'                           ok=True  errs=[] rows=[('/b.md', 'updated', 3)]
agent A's lost-reply retry of 'A'            ok=True  errs=[] rows=[('/b.md', 'updated', 4)]
   body now: 'A'  stat: [(4, '559aead0')]  version rows: 3

== 3. edit replay (server-side find-and-replace)
edit world->there                            ok=True  errs=[] rows=[('/e.md', 'updated', 2)]
edit world->there (replay)                   ok=False errs=[('vfs.invalid', False)] rows=[]
   stat: [(2, '12998c01')]

== 4. mkdir, delete, restore, move, copy replays
mkdir /d                                     ok=True  errs=[] rows=[('/d', 'created', 1)]
mkdir /d (replay)                            ok=False errs=[('vfs.exists', False)] rows=[]
