SQLite executes the three-seek join (json_each, MATERIALIZED CTE) inside the recursive member: yes, above.
Rendered SQL, placement A, sqlite:
WITH RECURSIVE visible AS MATERIALIZED 
(SELECT vfs_entries.entry_id AS entry_id 
FROM vfs_entries 
WHERE vfs_entries.everyone_level >= ? UNION ALL SELECT vfs_entries.entry_id AS entry_id 
FROM json_each(?) AS pts CROSS JOIN vfs_entries ON vfs_entries.path = pts.value AND vfs_entries.everyone_level < ? UNION ALL SELECT vfs_entries.entry_id AS entry_id 
FROM json_each(?) AS rng CROSS JOIN vfs_entries ON vfs_entries.path > json_extract(rng.value, ?) AND vfs_entries.path < json_extract(rng.value, ?) AND vfs_entries.everyone_level < ? UNION ALL SELECT vfs_entries.entry_id AS entry_id 
FROM json_each(?) AS pts CROSS JOIN vfs_entries ON vfs_entries.path = pts.value AND vfs_entries.owner_id = ? AND vfs_entries.everyone_level < ? UNION ALL SELECT vfs_entries.entry_id AS entry_id 
FROM json_each(?) AS rng CROSS JOIN vfs_entries ON vfs_entries.path > json_extract(rng.value, ?) AND vfs_entries.path < json_extract(rng.value, ?) AND vfs_entries.owner_id = ? AND vfs_entries.everyone_level < ?), 
walk(node, depth) AS 
(SELECT seed.entry_id AS node, ? AS depth 
FROM vfs_entries AS seed 
WHERE seed.deleted_at IS NULL AND seed.path != ? AND seed.path NOT LIKE ? ESCAPE '\' AND seed.entry_id IN (__[POSTCOMPILE_entry_id_1]) AND seed.entry_id IN (SELECT visible.entry_id 
FROM visible) UNION SELECT adj."to" AS node, w.depth + ? AS depth 
FROM walk AS w JOIN (SELECT vfs_edges.source_id AS frm, vfs_edges.target_id AS "to", vfs_edges.edge_type AS edge_type 
FROM vfs_edges 
WHERE vfs_edges.edge_type IN (__[POSTCOMPILE_edge_type_1])) AS adj ON adj.frm = w.node JOIN vfs_entries AS far ON far.entry_id = adj."to" JOIN visible ON visible.entry_id = far.entry_id 
WHERE w.depth < ? AND far.deleted_at IS NULL AND far.path != ? AND far.path NOT LIKE ? ESCAPE '\')
 SELECT walk.node, min(walk.depth) AS depth 
FROM walk GROUP BY walk.node

