== 2. a listing of a directory holding 10 live files and N tombstones
 -- /dir0: 10 live, 0 tombstoned
  ls /dir0 as system: rows returned=10 statements=3 vm_steps=355
  ls /dir0 as alice: rows returned=10 statements=5 vm_steps=401
  stat /dir0/live00.txt: rows returned=1 statements=2 vm_steps=117
  glob /dir0/live* : rows returned=10 statements=2 vm_steps=341
  delete /dir0/live09.txt cascade=False: rows returned=1 statements=10 vm_steps=805
  restore /dir0/live09.txt: rows returned=1 statements=11 vm_steps=643
 -- /dir1000: 10 live, 1000 tombstoned
  ls /dir1000 as system: rows returned=10 statements=3 vm_steps=5362
  ls /dir1000 as alice: rows returned=10 statements=5 vm_steps=5408
