== 1. the keys and indexes on vfs_entries, as SQLite holds them
  CREATE INDEX ix_vfs_entries_content_hash ON vfs_entries (content_hash)
  CREATE INDEX ix_vfs_entries_deleted_at ON vfs_entries (deleted_at)
  CREATE INDEX ix_vfs_entries_encoded_kind ON vfs_entries (encoded, kind)
  CREATE UNIQUE INDEX ix_vfs_entries_entry_id ON vfs_entries (entry_id)
  CREATE INDEX ix_vfs_entries_everyone_path ON vfs_entries (everyone_level, path)
  CREATE INDEX ix_vfs_entries_ext ON vfs_entries (ext)
  CREATE INDEX ix_vfs_entries_ext_kind ON vfs_entries (ext, kind)
  CREATE INDEX ix_vfs_entries_index_pending ON vfs_entries (encoded, chunked, indexable, deleted_at, id)
  CREATE INDEX ix_vfs_entries_kind ON vfs_entries (kind)
  CREATE INDEX ix_vfs_entries_owner_id ON vfs_entries (owner_id)
  CREATE UNIQUE INDEX ix_vfs_entries_path ON vfs_entries (path)
  CREATE INDEX ix_vfs_entries_render_status ON vfs_entries (render_status, deleted_at, id)
  CREATE INDEX ix_vfs_entries_trash_root ON vfs_entries (trash_root_id)
  sqlite_autoindex_vfs_entries_1: (automatic index for a UNIQUE constraint)
  table: id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  table: CONSTRAINT uq_vfs_entries_parent_name UNIQUE (parent_id, name)
