# Untrusted downloads (toolchains, source tarballs) and build trees: regenerated by scripts/00_download.sh and the build scripts.
downloads/*
!downloads/SHA256SUMS
!downloads/.gitkeep
build/
.venv-build/
__pycache__/
# Large artifacts (python.wasm, .cwasm, zips) stay out; their hashes and sizes are in outputs/.
*.wasm
*.cwasm
*.zip
*.tar.xz
*.tar.gz
# The root .gitignore drops *.log; the build and link logs are the spike's evidence and stay (1.5 MB in all).
!outputs/*.log
!outputs/cpython-floor-logs/*.log
