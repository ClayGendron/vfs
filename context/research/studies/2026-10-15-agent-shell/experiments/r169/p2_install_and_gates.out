== the gates a resolver relies on (posture none at /, bob list on upper, zed nothing)
[posture / none] success=True
[grant bob list /opt/bin] success=True
[bob stat upper.wasm] success=True
    row path=/opt/bin/upper.wasm kind=file mime=None source=None hash= v=None populated=['kind', 'path']
[bob ls /opt/bin] success=True
    row path=/opt/bin/fake.wasm kind=file mime=None source=None hash= v=None populated=['kind', 'path']
    row path=/opt/bin/upper.wasm kind=file mime=None source=None hash= v=None populated=['kind', 'path']
[bob read columns={content_hash,version}] success=False
    error kind=vfs.permission_denied sev=error path=/opt/bin/upper.wasm msg='Permission denied'
[bob read columns={data}] success=False
    error kind=vfs.permission_denied sev=error path=/opt/bin/upper.wasm msg='Permission denied'
[zed stat upper.wasm] success=False
    error kind=vfs.not_found sev=error path=/opt msg='Not found'
[grant bob read upper.wasm] success=True
[bob read columns={content_hash,version} (now read)] success=True
    row path=/opt/bin/upper.wasm kind=file mime=None source=None hash=f47e71368119 v=2 populated=['content_hash', 'kind', 'path', 'version']

