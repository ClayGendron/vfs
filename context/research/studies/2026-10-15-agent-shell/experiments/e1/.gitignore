# cargo build tree: keep only the wasm binaries the scripts load
guest/target/*
!guest/target/wasm32-wasip1/
guest/target/wasm32-wasip1/*
!guest/target/wasm32-wasip1/release/
guest/target/wasm32-wasip1/release/*
!guest/target/wasm32-wasip1/release/*.wasm
# compiled-module caches are regenerated by the step scripts
outputs/cache/
outputs/cache-step6/
# cargo install bookkeeping
downloads/jaq/.crates.toml
downloads/jaq/.crates2.json
__pycache__/
